\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Main result.} (a) Mean rare-cell F1 in the label-scarce regime ($p\le 0.10$), averaged over six datasets, three fractions and three seeds. (b) Worst-case FFR over the whole benchmark; the dashed line is the budget $\alpha =0.01$. scRareRefine is the only method that combines the highest scarce-regime F1 with a worst-case FFR $\le \alpha $. $\dagger $ HiCat is transductive.}}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:main}{{2}{6}{\textbf {Main result.} (a) Mean rare-cell F1 in the label-scarce regime ($p\le 0.10$), averaged over six datasets, three fractions and three seeds. (b) Worst-case FFR over the whole benchmark; the dashed line is the budget $\alpha =0.01$. scRareRefine is the only method that combines the highest scarce-regime F1 with a worst-case FFR $\le \alpha $. $\dagger $ HiCat is transductive}{figure.caption.9}{}}
\newlabel{fig:main@cref}{{[figure][2][]2}{[1][5][]6}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Component ablation}{6}{subsection.3.3}\protected@file@percent }
\newlabel{sec:results-ablation}{{3.3}{6}{Component ablation}{subsection.3.3}{}}
\newlabel{sec:results-ablation@cref}{{[subsection][3][3]3.3}{[1][6][]6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Ablation.} Left: leave-one-out over the four components (F1 top, worst-case FFR bottom). Right: candidate-rank sensitivity (fixed $k$ vs.\ validation-adaptive). Removing the conformal threshold or the separability gate barely changes mean F1 but breaks the FFR budget; the adaptive rank is the component that raises F1; a fixed rank $=3$ over-fires FFR.}}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:ablation}{{3}{7}{\textbf {Ablation.} Left: leave-one-out over the four components (F1 top, worst-case FFR bottom). Right: candidate-rank sensitivity (fixed $k$ vs.\ validation-adaptive). Removing the conformal threshold or the separability gate barely changes mean F1 but breaks the FFR budget; the adaptive rank is the component that raises F1; a fixed rank $=3$ over-fires FFR}{figure.caption.11}{}}
\newlabel{fig:ablation@cref}{{[figure][3][]3}{[1][6][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Separability-gate analysis.} (a,b) Controlled semi-synthetic stress test (entangling a rare type toward its nearest majority): rescue stays FFR-safe well below the gate at $1.3$. (c) Benchmark-wide sensitivity of the gate threshold: $1.3$ is the smallest threshold that keeps worst-case FFR $\le \alpha $ on real data.}}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:sep}{{4}{7}{\textbf {Separability-gate analysis.} (a,b) Controlled semi-synthetic stress test (entangling a rare type toward its nearest majority): rescue stays FFR-safe well below the gate at $1.3$. (c) Benchmark-wide sensitivity of the gate threshold: $1.3$ is the smallest threshold that keeps worst-case FFR $\le \alpha $ on real data}{figure.caption.12}{}}
\newlabel{fig:sep@cref}{{[figure][4][]4}{[1][7][]7}{}{}{}}
