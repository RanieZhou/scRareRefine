\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Rare-class F1 as a function of training size for ASDC (left) and cDC1 (right) in the Immune DC dataset. Lines are means over three seeds; shaded bands are $\pm 1$ SD. Gate+Marker and Fusion-gated maintain high F1 even at $n_\text  {rare} = 5$, where scANVI and kNN nearly or completely fail.}}{16}{figure.caption.16}\protected@file@percent }
\newlabel{fig:efficiency}{{1}{16}{Rare-class F1 as a function of training size for ASDC (left) and cDC1 (right) in the Immune DC dataset. Lines are means over three seeds; shaded bands are $\pm 1$ SD. Gate+Marker and Fusion-gated maintain high F1 even at $n_\text {rare} = 5$, where scANVI and kNN nearly or completely fail}{figure.caption.16}{}}
\newlabel{fig:efficiency@cref}{{[figure][1][]1}{[1][8][]16}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Separability ratio versus F1 gain (Gate+Marker $-$ scANVI) at $n_\text  {rare} = 20$. Each point represents a rare cell type; error bars show $\pm 1$ SD across seeds. The dashed vertical lines at $S= 1.1$ and $S= 1.3$ indicate the fallback and activation thresholds. All cell types with $S> 1.3$ show positive gain; all cell types with $S< 1.1$ show near-zero gain (|gain| $< 0.01$).}}{17}{figure.caption.19}\protected@file@percent }
\newlabel{fig:sepratio}{{2}{17}{Separability ratio versus F1 gain (Gate+Marker $-$ scANVI) at $n_\text {rare} = 20$. Each point represents a rare cell type; error bars show $\pm 1$ SD across seeds. The dashed vertical lines at $\sepratio = 1.1$ and $\sepratio = 1.3$ indicate the fallback and activation thresholds. All cell types with $\sepratio > 1.3$ show positive gain; all cell types with $\sepratio < 1.1$ show near-zero gain (|gain| $< 0.01$)}{figure.caption.19}{}}
\newlabel{fig:sepratio@cref}{{[figure][2][]2}{[1][8][]17}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Overview of the scRareRefine pipeline. After scANVI training and query inference, the separability ratio $S$ is computed from labeled training cells. If $S \geq 1.1$, prototype scoring generates rescue candidates; the gate filters candidates by margin threshold; and marker-gene verification confirms biological plausibility. If $S < 1.1$, the pipeline falls back to scANVI predictions without modification. All reference quantities are derived from training data only; test-set labels are used solely for final evaluation.}}{17}{figure.caption.20}\protected@file@percent }
\newlabel{fig:framework}{{3}{17}{Overview of the scRareRefine pipeline. After scANVI training and query inference, the separability ratio $S$ is computed from labeled training cells. If $S \geq 1.1$, prototype scoring generates rescue candidates; the gate filters candidates by margin threshold; and marker-gene verification confirms biological plausibility. If $S < 1.1$, the pipeline falls back to scANVI predictions without modification. All reference quantities are derived from training data only; test-set labels are used solely for final evaluation}{figure.caption.20}{}}
\newlabel{fig:framework@cref}{{[figure][3][]3}{[1][9][]17}{}{}{}}
